
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/InvoiceLayoutMain.cshtml";
}

<table class="table table-borderless">
    <tr>
        <td style="text-align:right">
            <label>Customer</label>
        </td>
        <td>
            @Html.DropDownList("ddcustomer", ViewBag.customers as SelectList, "Select Customer", new { @class = "form-control" })
        </td>
        <td style="text-align:right">
            <label>Invoice Date</label>
        </td>
        <td>
            <input type="date" id="txtdate" class="form-control" />

        </td>
    </tr>
</table>

<table class="table table-borderless">
    <tr>
        <td>
            <label>Product</label>
            @Html.DropDownList("ddproduct", ViewBag.products as SelectList, "Product", new { @class = "form-control", @onchange = "FetchProduct()" })
        </td>
        <td>
            <label>Rate</label><br />
            <input type="text" id="txtrate" class="form-control" style="width:100px" />
        </td>
        <td>
            <label>Gst</label><br />
            <input type="text" id="txtgst" class="form-control" style="width:100px" />
        </td>
        <td>
            <label>Stock</label><br />
            <input type="text" id="txtstock" class="form-control" style="width:100px" />
        </td>
        <td>
            <label>Quantity</label><br />
            <input type="text" id="txtquantity" class="form-control" style="width:100px" , onchange="Total()" />
        </td>
        <td>
            <label>Total</label><br />
            <input type="text" id="txttotal" class="form-control" style="width:100px" />
        </td>
        <td>
            <br />
            <input type="button" id="btnadd" onclick="AddProduct()" class="btn btn-primary" value="+" />
        </td>

    </tr>
</table>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Sr No</th>
            <th>Product Name</th>
            <th>Rate</th>
            <th>Gst</th>
            <th>Quantity</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody id="tbldata"></tbody>
    <tfoot>
        <tr>
            <td style="text-align:right" colspan="5"> Total</td>
            <td><b id="finaltotal"></b></td>
        </tr>
    </tfoot>
</table>
<input type="button" value="Submit" onclick="SubmitInvoice()" class="btn btn-primary" />

<div class="mt-5">
    <div class="">
        <h5 id="cname">Customer Name :</h5>
        <h5 id="idate">Invoice Date :</h5>
    </div>
    <div class="col-md-12">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Sr No</th>
                    <th>Product Name</th>
                    <th>Rate</th>
                    <th>Gst</th>
                    <th>Quantity</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody id="tbldata">
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5" style="margin-right:10px">Grand Total:</td>
                    <td id="finaltotal"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
<script>
    var product[];
    var rate,gst;
    var pname="";
    const FetchProduct=async()=>
    {
        var pid=document.getElementById("ddproduct").value;

        const response = await fetch("/Product/GetProduct/"+pid);
        const p = await response.json();

        pname = p.productName;
        document.getElementById("txtrate").value = p.rate;
        document.getElementById("txtgst").value = p.gst;
        document.getElementById("txtstock").value = p.stock;
        rate = p.rate;
        gst = p.gst;
    }
    const Total = async()=>
    {
        var qty=document.getElementById("txtquantity").value;
        var t=(Number(rate)*Number(qty)*Number(gst))/100+Number(rate)*Number(qty)
        document.getElementById("txttotal").value=t;
    }
    const AddProduct = async()=>
    {
        var pid=document.getElementById("ddproduct").value;
        var prate=document.getElementById("txtrate").value;
        var pgst=document.getElementById("txtgst").value;
        var qty=document.getElementById("txtquantity").value;
        var t=document.getElementById("txttotal").value;
        var pr={"Product":pid,"ProductName":pname,"Rate":prate,"Gst":pgst,"Quantity":qty,"Total":t};
        product.push(pr);
        clearData();
        DisplayTable();
    }
    const DisplayTable=()=>
    {
        var data="";
        var final=0;
        product.foreach(function(d,k)
        {
            final=number(final)+Number(d.Total);
            data+="<tr><td>"+(k+1)+"</td><td>"+d.ProductName+"</td><td>"+d.Rate+"</td><td>"+d.Gst+"</td><td>"+d.Quantity+"</td><td>"+d.Total+"</td></tr>";
        });
        document.getElementById("tbldata").innerHTML=data;
        document.getElementById("finaltotal").innerHTML=final;
    }

    ClearData=()=>
    {
        var pname=document.getElementById("ddproduct").value="";
        var prate=document.getElementById("txtrate").value="";
        var pgst=document.getElementById("txtgst").value="";
        var psqty=document.getElementById("txtstock").value="";
        var t=document.getElementById("txttotal").value="";
        var qty =document.getElementById("txtquantity").value="";
    }
</script>
