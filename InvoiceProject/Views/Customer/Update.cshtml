@model TblCustomer
@{
    ViewData["Title"] = "Update";
    Layout = "~/Views/Shared/InvoiceLayoutMain.cshtml";
}
<div class="container">
    <div class="row">
        <div class="col-md-5">
            @using (Html.BeginForm())
            {
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Add Customer</h3>
                    </div>
                    <div class="card-body">
                        <div class="mt-2">
                            <label>Customer Id</label>
                            @Html.TextBoxFor(e => e.CustomerId, new { @class = "form-control" })
                        </div>
                        <div class="mt-2">
                            <label>Customer Name</label>
                            @Html.TextBoxFor(e => e.CustomerName, new { @class = "form-control" })
                        </div>
                        <div class="mt-2">
                            <label>Customer Email</label>
                            @Html.TextBoxFor(e => e.Email, new { @class = "form-control" })
                        </div>
                        <div class="mt-2">
                            <label>Customer Mobile Number</label>
                            @Html.TextBoxFor(e => e.Mobile, new { @class = "form-control" })
                        </div>
                        <div class="mt-2">
                            <label>Customer City</label>
                            @Html.TextBoxFor(e => e.City, new { @class = "form-control" })
                        </div>
                    </div>
                    <duv class="card-footer">
                        <input type="submit" value="Update" class="btn btn-dark" />
                        <input type="reset" value="Cancle" class="btn btn-danger" />
                    </duv>
                </div>
            }
        </div>
    </div>
</div>
