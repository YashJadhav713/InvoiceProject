@model Customer
@{
    ViewData["Title"] = "CustomerAdd";
    Layout = "~/Views/Shared/InvoiceLayoutMain.cshtml";
    List<TblCustomer> lst = (List<TblCustomer>)ViewData["customer"];
}

<div class="container">
    <div class="row">
        <div class="col-md-5">
            @using(Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="card">
                    <h3 class="card-title">Add Customer</h3>
                </div>
                <div class="card-body">
                    <div class="mt-2">
                        <label>Customer Name</label>
                        @Html.TextBoxFor(e => e.CustomerName, new { @class = "form-control" })
                        <h6 style="color:red">@Html.ValidationMessageFor(e => e.CustomerName)</h6>
                    </div>
                    <div class="mt-2">
                        <label>Email</label>
                        @Html.TextBoxFor(e => e.Email, new { @class = "form-control" })
                        <h6 style="color:red">@Html.ValidationMessageFor(e => e.Email)</h6>
                    </div>
                    <div class="mt-2">
                        <label>Mobile Number</label>
                        @Html.TextBoxFor(e => e.Mobile, new { @class = "form-control" })
                        <h6 style="color:red">@Html.ValidationMessageFor(e => e.Mobile)</h6>
                    </div>
                    <div class="mt-2">
                        <label>City</label>
                        @Html.TextBoxFor(e => e.City, new { @class = "form-control" })
                        <h6 style="color:red">@Html.ValidationMessageFor(e => e.City)</h6>
                    </div>
                    <duv class="card-footer">
                        <input type="submit" value="Add Customer" class="btn btn-dark" />
                        <input type="reset" value="Cancle" class="btn btn-danger" />
                    </duv>
                </div>
            }
        </div>
        <div class="col-md-7">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Customer Name</th>
                        <th>Email</th>
                        <th>Mobile Number</th>
                        <th>City</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in lst)
                    {
                        <tr>
                            <td>@item.CustomerName</td>
                            <td>@item.Email</td>
                            <td>@item.Mobile</td>
                            <td>@item.City</td>
                            <td class="d-flex">
                                <a href="/Customer/Update/@item.CustomerId" class="btn btn-info btn-sm">Update</a>&nbsp;
                                <a href="/Customer/Delete/@item.CustomerId" class="btn btn-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>